{
  "name": "claude-agent-team-kanban",
  "displayName": "Claude Agent Team Kanban",
  "description": "A Kanban board that displays the internal task list from Claude Code agent teams",
  "version": "0.1.4",
  "publisher": "ericman93",
  "icon": "resources/icon.png",
  "author": "Eric Feldman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ericf/claude-agent-team-board"
  },
  "bugs": {
    "url": "https://github.com/ericf/claude-agent-team-board/issues"
  },
  "homepage": "https://github.com/ericf/claude-agent-team-board#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeAgentTeamBoard.openBoard",
        "title": "Open Agent Team Board",
        "category": "Claude"
      }
    ],
    "configuration": {
      "title": "Claude Agent Team Board",
      "properties": {
        "claude-agent-team-board.tasksDirectory": {
          "type": "string",
          "default": "",
          "description": "Path to Claude Code tasks directory. Leave empty for auto-detection (~/.claude/tasks)."
        },
        "claude-agent-team-board.teamsDirectory": {
          "type": "string",
          "default": "",
          "description": "Path to Claude Code teams directory. Leave empty for auto-detection (~/.claude/teams)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "install-ext": "npm run compile && ln -sf \"$(pwd)\" \"$HOME/.vscode/extensions/claude-agent-team-board\"",
    "export": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}